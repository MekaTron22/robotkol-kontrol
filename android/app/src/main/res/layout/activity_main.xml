<?xml version="1.0" encoding="utf-8"?>
<!--
  Yatay (landscape) yerleşim, iki başparmakla kullanım için:
  - Sürüş sürgüleri ekranın iki kenarında (başparmak altında).
  - ACİL DUR sağ üstte, büyük ve kırmızı (sağ başparmağa yakın).
  - Ortada: üstte kök çarkı + kıskaç/rotasyon, altta büyük kol alanı.
  Her denetim kendi kartını çizer; kartlar arası boşluk görünümlerin iç payıyla gelir.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="4dp"
    android:splitMotionEvents="true">

    <!-- Üst çubuk -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <Button
            android:id="@+id/btnConnect"
            style="@style/BarButton"
            android:layout_marginStart="0dp"
            android:background="@drawable/bg_btn_accent"
            android:textColor="#14100C"
            android:text="@string/connect" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_status"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#8A93A6"
            android:textSize="13sp" />

        <Button android:id="@+id/btnSpeed" style="@style/BarButton" />
        <Button android:id="@+id/btnLight" style="@style/BarButton" android:text="@string/light" />
        <Button android:id="@+id/btnPoses" style="@style/BarButton" android:text="@string/poses" />
        <Button android:id="@+id/btnHome" style="@style/BarButton" android:text="@string/home" />
        <Button android:id="@+id/btnSettings" style="@style/BarButton" android:text="@string/settings" />
        <Button
            android:id="@+id/btnStop"
            style="@style/BarButton"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_btn_estop"
            android:minWidth="110dp"
            android:text="@string/estop"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Ana alan: sol DC | merkez | sağ DC -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:splitMotionEvents="true">

        <com.mekatron.robotkol.ui.DriveSliderView
            android:id="@+id/driveLeft"
            android:layout_width="100dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:splitMotionEvents="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="31"
                android:orientation="horizontal"
                android:splitMotionEvents="true">

                <com.mekatron.robotkol.ui.RootWheelView
                    android:id="@+id/rootWheel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8" />

                <com.mekatron.robotkol.ui.HSliderView
                    android:id="@+id/gripSlider"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <com.mekatron.robotkol.ui.HSliderView
                    android:id="@+id/rollSlider"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <com.mekatron.robotkol.ui.ArmView
                android:id="@+id/armView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="69" />
        </LinearLayout>

        <com.mekatron.robotkol.ui.DriveSliderView
            android:id="@+id/driveRight"
            android:layout_width="100dp"
            android:layout_height="match_parent" />
    </LinearLayout>
</LinearLayout>
